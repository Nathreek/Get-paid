# Copy to .env for local runs. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit the real .env — it holds your payout wallet's private key.

# Permanent database (Turso). Leave blank locally to use data/get-paid.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Post checker (gpt-oss on Groq, free key at console.groq.com)
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Payouts
# Secret key of a dedicated hot wallet holding only what you plan to pay out (base58, or the JSON array from solana-keygen).
PAYOUT_PRIVATE_KEY=
# Nothing is sent until this is exactly "true".
PAYOUTS_ENABLED=false
# Free RPCs (Helius, QuickNode) are far more reliable than the public default.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
MAX_DAILY_PAYOUT_USD=100
# Payout amount (USD, sent as SOL at the live price).
# Fixed: every approved post gets this amount. Leave blank to use tiers.
PAYOUT_FIXED_USD=
# Tiers: USD ranges, rising one tier every PAYOUT_TIER_SIZE payouts; the last tier is the max. A single number means exactly that amount.
PAYOUT_TIERS=5-30
PAYOUT_TIER_SIZE=30
PAYOUT_INTERVAL_SECONDS=10
MAX_PAYOUTS_PER_ACCOUNT=1
# Posts made before this time are rejected (ISO date, optional).
CAMPAIGN_START=

# Coin launches (optional)
# One secret controls every launched coin's payout wallet: a 12/24-word seed phrase (or 128 hex characters).
# Coin #i uses the path m/44'/501'/i'/0', so importing the phrase into Phantom shows each coin's wallet as account i.
# Generate a fresh phrase just for this, back it up offline, and never reuse it. Anyone with it controls every coin's fees.
MASTER_SEED=
# Uploads each coin's image and metadata to IPFS (free JWT at pinata.cloud). Without it, new launches are off.
PINATA_JWT=
# Optional: your Pinata gateway, e.g. https://yourname.mypinata.cloud (default https://ipfs.io).
PINATA_GATEWAY=
